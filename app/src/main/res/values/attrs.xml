<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="CustomRoundedImageView">
        <attr name="border_width" format="dimension" />
        <attr name="border_color" format="color" />
        <attr name="radius" format="dimension" />
        <attr name="radius_top_left" format="dimension" />
        <attr name="radius_top_right" format="dimension" />
        <attr name="radius_bottom_left" format="dimension" />
        <attr name="radius_bottom_right" format="dimension" />
        <attr name="is_circle" format="boolean" />
    </declare-styleable>

    <declare-styleable name="CommonActionBar">
        <attr name="title" format="string"/>
    </declare-styleable>

    <declare-styleable name="TextInputView">
        <!-- Thuộc tính cho title -->
        <attr name="titleVisible" format="boolean" />
        <attr name="titleText" format="string" />

        <!-- Thuộc tính cho EditText -->
        <attr name="hintText" format="string" />
        <attr name="text" format="string" />
        <attr name="inputType" format="enum">
            <enum name="text" value="1" />
            <enum name="textPassword" value="129" />
            <enum name="number" value="2" />
            <enum name="phone" value="3" />
            <enum name="textEmailAddress" value="33" />
            <enum name="textMultiLine" value="131073" />
        </attr>

        <!-- Thuộc tính cho error -->
        <attr name="errorVisible" format="boolean" />
        <attr name="errorText" format="string" />
    </declare-styleable>
</resources>